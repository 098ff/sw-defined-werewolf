# Environment Variables Template
# Copy to .env for local overrides (never commit .env)

# StateStore Backend: 'redis' or 'in_memory'
STATE_STORE_BACKEND=redis
REDIS_URL=redis://localhost:6379

# Internal Microservice Routing URLs
LOBBY_URL=http://localhost:8001
GAMEMASTER_URL=http://localhost:8002
CHAT_URL=http://localhost:8003
FRONTEND_URL=http://localhost:3000

# Gateway Configuration
GATEWAY_PORT=8080
GATEWAY_HOST=0.0.0.0

# Demo Mode Secrets
DEMO_MODE=true
DEMO_SECRET=sds-werewolf-demo-secret
